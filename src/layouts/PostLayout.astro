---
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';
import {formatDate} from '../lib/content';
interface Props { title:string; description:string; date:Date; tags:string[]; section:'blog'|'projects'; github?:string }
const {title,description,date,tags,section,github}=Astro.props;
---
<BaseLayout title={title} description={description}><a class="back-link" href={'/'+section+'/'}>← {section==='blog'?'TECH BLOG':'PROJECTS'}</a><article><time class="entry-meta" datetime={date.toISOString()}>{formatDate(date)}</time><h1 class="article-title">{title}</h1><p class="page-intro">{description}</p><div class="tags">{tags.map(t=><span class="tag">{t}</span>)}</div>{github && <p><a href={github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></p>}<div class="prose"><slot/></div></article></BaseLayout>