---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VisitorStats from '../../components/blog/VisitorStats.astro';
import { published, formatDate, excerpt } from '../../lib/content';
import { blogCategories } from '../../data/blog';
import '../../styles/light.css';
import '../../styles/blog.css';
const posts = await published('blog');
const tags = [...new Set(posts.flatMap(post => post.data.tags))].sort((a, b) => a.localeCompare(b, 'ko'));
const groupedTags = new Set(blogCategories.flatMap(category => [category.name, ...category.children]));
const categories = [
  ...blogCategories.filter(category => [category.name, ...category.children].some(tag => tags.includes(tag))),
  ...tags.filter(tag => !groupedTags.has(tag)).map(name => ({ name, children: [] as string[] })),
];
const countPosts = (categoryTags: string[]) => posts.filter(post => post.data.tags.some(tag => categoryTags.includes(tag))).length;
---
<BaseLayout title="Tech Blog" contentTheme="light">
  <div class="blog-layout">
    <div class="blog-heading">
      <p class="blog-count" aria-live="polite">전체 <span id="post-count">{posts.length}</span>개의 글</p>
    </div>
    <section class="blog-feed" aria-label="글 목록">
      <div class="blog-posts">
        {posts.map(post => (
          <article class="blog-post" data-post data-title={post.data.title} data-content={`${post.data.description} ${post.body ?? ''}`} data-tags={JSON.stringify(post.data.tags)}>
            <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
            <p class="blog-excerpt">{excerpt(post.body ?? '') || post.data.description}</p>
            <div class="blog-post-meta"><time datetime={post.data.time ? `${formatDate(post.data.date)}T${post.data.time}:00+09:00` : formatDate(post.data.date)}>{formatDate(post.data.date)}{post.data.time ? ` · ${post.data.time}` : ' · 시간 미기록'}</time></div>
          </article>
        ))}
      </div>
      <p class="blog-empty" id="blog-empty" hidden={posts.length > 0}>조건에 맞는 글이 없습니다.</p>
    </section>
    <aside class="blog-sidebar" aria-label="블로그 메뉴">
      <form class="blog-search" role="search">
        <div class="blog-search-field"><svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg><input type="search" id="blog-query" name="q" aria-label="검색" placeholder="검색어를 입력 후 엔터를 누르세요."/></div>
      </form>
      <nav class="blog-menu" aria-label="전체 카테고리">
        <div class="blog-menu-all"><span>전체 글</span><span>{posts.length}</span></div>
        <ul>{categories.map(category => (
          <li>
            <a class="blog-category-parent" href={`?tag=${encodeURIComponent(category.name)}`} data-filter={category.name} data-filter-tags={JSON.stringify([category.name, ...category.children])}><span>{category.name}</span><span>{countPosts([category.name, ...category.children])}</span></a>
            {category.children.some(tag => tags.includes(tag)) && <ul>{category.children.filter(tag => tags.includes(tag)).map(tag => (
              <li><a class="blog-subcategory" href={`?tag=${encodeURIComponent(tag)}`} data-filter={tag}><span>{tag}</span><span>{countPosts([tag])}</span></a></li>
            ))}</ul>}
          </li>
        ))}</ul>
      </nav>
      <VisitorStats />
    </aside>
  </div>
</BaseLayout>
<script>import '../../scripts/blog';</script>
